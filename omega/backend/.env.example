# Server Configuration
PORT=5001
NODE_ENV=production
APP_NAME=KhmerGhostOmega
APP_URL=https://omega.khmerghost.com
API_URL=https://api.omega.khmerghost.com

# Database Configuration
DB_HOST=postgres-master
DB_PORT=5432
DB_USERNAME=omega_admin
DB_PASSWORD=omega_super_secret
DB_DATABASE=khmerghost_omega

# Read Replica
DB_REPLICA_HOST=postgres-replica
DB_REPLICA_PORT=5432

# MongoDB (Analytics)
MONGODB_HOST=mongodb
MONGODB_PORT=27017
MONGODB_USERNAME=omega_admin
MONGODB_PASSWORD=omega_super_secret
MONGODB_DATABASE=omega_analytics

# Cassandra (Big Data)
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=omega_bigdata

# Redis Cache
REDIS_HOST=redis-master
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# Kafka Event Streaming
KAFKA_BROKERS=kafka:9092
KAFKA_GROUP_ID=omega-group
KAFKA_CLIENT_ID=omega-backend

# JWT Authentication
JWT_SECRET=omega-super-secret-key-2024-please-change-this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Multi-AI APIs
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxx
OPENAI_MODEL=gpt-4-turbo-preview

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-3-opus-20240229

GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_MODEL=gemini-1.5-pro

REPLICATE_API_KEY=r8_xxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Payment Gateways
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_STARTER=price_xxxxxxxx
STRIPE_PRICE_PROFESSIONAL=price_xxxxxxxx
STRIPE_PRICE_BUSINESS=price_xxxxxxxx
STRIPE_PRICE_ENTERPRISE=price_xxxxxxxx
STRIPE_PRICE_ULTIMATE=price_xxxxxxxx

PAYPAL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_MODE=live

WING_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
WING_MERCHANT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

ABA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
ABA_MERCHANT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

COINBASE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
COINBASE_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Social Media APIs
FACEBOOK_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
FACEBOOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

TIKTOK_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
TIKTOK_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

INSTAGRAM_APP_ID=xxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
INSTAGRAM_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx

LINKEDIN_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

TWITTER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
TWITTER_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

YOUTUBE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxx
YOUTUBE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Cloud Services
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=khmerghost-omega
AWS_S3_BUCKET_MEDIA=khmerghost-media
AWS_S3_BUCKET_BACKUP=khmerghost-backup

CLOUDFLARE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ZONE_ID=xxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Monitoring & Logging
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/123456
NEW_RELIC_LICENSE_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
DATADOG_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
DATADOG_APP_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

ELASTICSEARCH_URL=http://elasticsearch:9200
LOGSTASH_URL=http://logstash:5000

PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@khmerghost.com
SMTP_PASS=xxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@khmerghost.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890

# CDN
CDN_URL=https://cdn.khmerghost.com
CLOUDINARY_CLOUD_NAME=khmerghost
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Security
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=1000
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900

# Features
ENABLE_MULTI_REGION=true
ENABLE_QUANTUM_ENCRYPTION=false
ENABLE_BLOCKCHAIN_VERIFICATION=true
ENABLE_NFT_ACHIEVEMENTS=true

# Cache
CACHE_TTL=3600
CACHE_CHECK_PERIOD=600

# WebSocket
WS_PORT=5002
WS_PATH=/socket.io

# File Upload
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,video/mp4
