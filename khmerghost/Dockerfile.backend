# Backend Dockerfile
FROM node:20-alpine

# Install build dependencies + ADB tools + Chromium for Playwright
RUN apk add --no-cache python3 make g++ android-tools \
    chromium nss freetype harfbuzz ca-certificates ttf-freefont

# Tell Playwright to use system Chromium
ENV PLAYWRIGHT_BROWSERS_PATH=0
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium-browser

WORKDIR /app

# Copy package files
COPY backend/package*.json ./

# Install dependencies and rebuild sqlite3
RUN npm install && npm rebuild sqlite3

# Copy backend code (excluding node_modules via .dockerignore)
COPY backend/*.js ./
COPY backend/config ./config
COPY backend/routes ./routes
COPY backend/services ./services
COPY backend/utils ./utils

# Create data and logs directories
RUN mkdir -p /app/data /app/logs

# Expose port
EXPOSE 3000

# Start server
CMD ["npm", "run", "dev"]
